# Copiar a .env y ajustar. docker compose lo lee automáticamente.

# --- Base de datos (PostgreSQL del docker-compose) ---
POSTGRES_DB=champions
POSTGRES_USER=champions
POSTGRES_PASSWORD=cambia-esta-clave

# --- Puerto publicado en el host ---
APP_PUERTO=8000

# --- Fuente de partidos ---
# Por defecto, la API simulada que levanta el compose (servicio mock-api).
API_PARTIDOS_URL=http://mock-api:8081/v4
API_PARTIDOS_TOKEN=
# Para usar la API pública real (token gratuito en https://www.football-data.org/client/register):
# API_PARTIDOS_URL=https://api.football-data.org/v4
# API_PARTIDOS_TOKEN=tu-token
COMPETICION=CL
TEMPORADA=

# --- Otros ---
ZONA_HORARIA=America/Lima
SINCRONIZAR_AL_INICIAR=true

# --- Imágenes publicadas (Docker Hub: tu-usuario | GHCR: ghcr.io/tu-usuario) ---
IMAGE_PREFIX=el3302
TAG=latest

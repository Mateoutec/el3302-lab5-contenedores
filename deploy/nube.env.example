# Copiar a deploy/nube.env y completar. desplegar-ec2.sh lo sube al servidor como .env
# (nunca se guarda en Git).

# Imágenes publicadas: Docker Hub "tu-usuario" o GHCR "ghcr.io/tu-usuario"
IMAGE_PREFIX=ghcr.io/tu-usuario
TAG=latest

# Contraseñas de las bases de datos (inventa unas largas)
P1_DB_PASSWORD=
P2_DB_PASSWORD=

# P1: API de partidos (vacío = API simulada incluida)
API_PARTIDOS_URL=
API_PARTIDOS_TOKEN=

# P2: la URL pública la completa el script con la IP del servidor si la dejas vacía
URL_PUBLICA=
PROVEEDOR_GUIONES=auto
ANTHROPIC_API_KEY=
PROVEEDOR_IMAGENES=local
OPENAI_API_KEY=
MODO_PUBLICACION=simulado
IG_USER_ID=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

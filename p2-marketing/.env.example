# Copiar a .env y ajustar. docker compose lo lee automáticamente.

# --- Base de datos (PostgreSQL del docker-compose) ---
POSTGRES_DB=marketing
POSTGRES_USER=marketing
POSTGRES_PASSWORD=cambia-esta-clave

# --- Puerto y URL pública (la URL debe ser accesible desde internet para publicar en Instagram) ---
APP_PUERTO=8080
URL_PUBLICA=http://localhost:8080

# --- IA para los guiones ---
# auto = usa Claude si hay ANTHROPIC_API_KEY; si no, plantillas locales. Valores: auto | claude | plantilla
PROVEEDOR_GUIONES=auto
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-opus-5-5

# --- Fotos ---
# local = diseño con Pillow sobre la foto subida (sin costo) | openai = fotos nuevas con gpt-image-1
PROVEEDOR_IMAGENES=local
OPENAI_API_KEY=
MODELO_IMAGEN_OPENAI=gpt-image-1

# --- Publicación en redes ---
# simulado = registra la publicación y muestra la vista previa | real = usa las APIs oficiales
MODO_PUBLICACION=simulado
# Instagram Graph API (cuenta profesional vinculada a una app de Meta)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0
IG_GRAPH_HOST=https://graph.facebook.com
# TikTok Content Posting API (scope video.publish; apps sin auditar solo publican en privado)
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACIDAD=SELF_ONLY

# --- Imágenes publicadas (Docker Hub: tu-usuario | GHCR: ghcr.io/tu-usuario) ---
IMAGE_PREFIX=el3302
TAG=latest
